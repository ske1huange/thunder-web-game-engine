{
  "name": "@thunder/render",
  "version": "0.1.0",
  "description": "Thunder Render —— 基于 three.js 的渲染层：多光源与阴影、后期调色、物理世界同步",
  "keywords": [
    "three",
    "webgl",
    "lighting",
    "shadow",
    "color-grading",
    "tone-mapping",
    "lut",
    "physics"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@thunder/physics": "workspace:^",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@thunder/physics": "workspace:*",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  }
}

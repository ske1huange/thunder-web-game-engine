{
  "name": "@thunder/physics",
  "version": "0.1.0",
  "description": "Thunder Physics —— 面向 HTML5 游戏的纯 TypeScript 3D 刚体物理引擎",
  "keywords": [
    "physics",
    "physics-engine",
    "3d",
    "rigid-body",
    "collision-detection",
    "html5",
    "game",
    "typescript",
    "trimesh",
    "heightfield",
    "character-controller",
    "vehicle",
    "ragdoll",
    "web-worker",
    "three"
  ],
  "license": "MIT",
  "author": "ske1huange",
  "homepage": "https://github.com/ske1huange/thunder-web-game-engine/tree/main/packages/physics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ske1huange/thunder-web-game-engine.git",
    "directory": "packages/physics"
  },
  "bugs": {
    "url": "https://github.com/ske1huange/thunder-web-game-engine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/thunder-physics.global.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
